{
  "build": {
    "builder": "NIXPACKS",
    "nixpacksConfigPath": "backend/chatbot/nixpacks.toml",
    "buildCommand": "cd backend/chatbot && pip install --break-system-packages -r requirements.txt"
  },
  "deploy": {
    "startCommand": "cd backend/chatbot && gunicorn api_chat:app",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
